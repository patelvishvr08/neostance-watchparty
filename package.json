{
  "name": "neostance-watchparty",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:local": "node scripts/build-local.mjs",
    "start:local": "node scripts/local-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:realtime": "node tests/realtime-benchmark.mjs",
    "start": "node scripts/local-server.mjs",
    "build": "node scripts/build-local.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node scripts/build-local.mjs && node scripts/local-server.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  },
  "description": "A shared movie night with synchronized playback, chat, polls and a ready-room countdown."
}
